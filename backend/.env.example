# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nestjs_boilerplate?schema=public"

# JWT
# IMPORTANT: Use strong random secrets (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_for_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_openssl_rand_hex_32
JWT_REFRESH_EXPIRES_IN=7d

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="NestJS App <noreply@example.com>"

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
